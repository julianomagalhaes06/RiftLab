{
  "components": {
    "schemas": {
      "BudgetSource": {
        "description": "docs/domain-model.md: budget_source: UNKNOWN, FRAME_ESTIMATE,\nUSER_PROVIDED.",
        "enum": [
          "UNKNOWN",
          "FRAME_ESTIMATE",
          "USER_PROVIDED"
        ],
        "title": "BudgetSource",
        "type": "string"
      },
      "CursorPage_DecisionStateSummary_": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DecisionStateSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "CursorPage[DecisionStateSummary]",
        "type": "object"
      },
      "DecisionBudget": {
        "additionalProperties": false,
        "description": "Orçamento imediato, separado da elegibilidade. `value` é null quando\ndesconhecido (nunca 0). STALE_FRAME/UNKNOWN_BUDGET em `codes` impedem\nafirmar compra imediata, mas não tornam a decisão inelegível.",
        "properties": {
          "codes": {
            "items": {
              "type": "string"
            },
            "title": "Codes",
            "type": "array"
          },
          "frameAgeMs": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frameagems"
          },
          "immediatePurchaseAssertable": {
            "title": "Immediatepurchaseassertable",
            "type": "boolean"
          },
          "source": {
            "$ref": "#/components/schemas/BudgetSource"
          },
          "staleFrame": {
            "title": "Staleframe",
            "type": "boolean"
          },
          "value": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "source",
          "staleFrame",
          "immediatePurchaseAssertable"
        ],
        "title": "DecisionBudget",
        "type": "object"
      },
      "DecisionInventory": {
        "additionalProperties": false,
        "description": "Inventário ANTES da decisão como multiconjunto (nunca um conjunto de ids\nsoltos: dois itens iguais são quantity=2). `trinket_item_id` é uma slot\nseparada; null = slot vazia (estado conhecido).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InventoryItem"
            },
            "title": "Items",
            "type": "array"
          },
          "trinketItemId": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trinketitemid"
          }
        },
        "title": "DecisionInventory",
        "type": "object"
      },
      "DecisionReason": {
        "additionalProperties": false,
        "description": "Motivo de inelegibilidade. `code` no vocabulário do contrato\n(MISSING_CATALOG, OUT_OF_SCOPE, INVENTORY_UNCERTAIN) mais o neutro\nTARGET_NOT_ELIGIBLE; `sub_reasons` preserva literalmente os códigos de\norigem. Nunca revela a classe do item comprado nem que a compra foi\ndesfeita (modo Estudo: antes de revelar, só informação pré-decisão).",
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "subReasons": {
            "items": {
              "type": "string"
            },
            "title": "Subreasons",
            "type": "array"
          }
        },
        "required": [
          "code"
        ],
        "title": "DecisionReason",
        "type": "object"
      },
      "DecisionState": {
        "additionalProperties": false,
        "description": "GET /decisions/{id} (CC-204): \"snapshot, inventário, fonte de orçamento,\nelegibilidade\" — SÓ informação pré-decisão (ver DecisionStateSummary).",
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/DecisionBudget"
          },
          "decisionId": {
            "format": "uuid",
            "title": "Decisionid",
            "type": "string"
          },
          "eligible": {
            "title": "Eligible",
            "type": "boolean"
          },
          "eventSourceIndex": {
            "minimum": 0.0,
            "title": "Eventsourceindex",
            "type": "integer"
          },
          "inventory": {
            "$ref": "#/components/schemas/DecisionInventory"
          },
          "level": {
            "$ref": "#/components/schemas/ObservedLevel"
          },
          "mainItemOrdinal": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mainitemordinal"
          },
          "matchId": {
            "title": "Matchid",
            "type": "string"
          },
          "participantId": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Participantid",
            "type": "integer"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/DecisionReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "timestampMs": {
            "minimum": 0.0,
            "title": "Timestampms",
            "type": "integer"
          },
          "versions": {
            "$ref": "#/components/schemas/DecisionVersionInfo"
          }
        },
        "required": [
          "decisionId",
          "matchId",
          "participantId",
          "eventSourceIndex",
          "timestampMs",
          "eligible",
          "inventory",
          "budget",
          "level",
          "versions"
        ],
        "title": "DecisionState",
        "type": "object"
      },
      "DecisionStateSummary": {
        "additionalProperties": false,
        "description": "Item de GET /matches/{id}/decisions (CC-204): SÓ informação pré-decisão.\n`decision_id` é o id do PONTO de decisão. Proibido aqui: item comprado,\nclasse do alvo, bloco retrospectivo, features, qualidade cumulativa e\nsubject_hash.",
        "properties": {
          "budgetSource": {
            "$ref": "#/components/schemas/BudgetSource"
          },
          "decisionId": {
            "format": "uuid",
            "title": "Decisionid",
            "type": "string"
          },
          "eligible": {
            "title": "Eligible",
            "type": "boolean"
          },
          "eventSourceIndex": {
            "minimum": 0.0,
            "title": "Eventsourceindex",
            "type": "integer"
          },
          "frameAgeMs": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frameagems"
          },
          "mainItemOrdinal": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mainitemordinal"
          },
          "participantId": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Participantid",
            "type": "integer"
          },
          "reasonCodes": {
            "items": {
              "type": "string"
            },
            "title": "Reasoncodes",
            "type": "array"
          },
          "staleFrame": {
            "title": "Staleframe",
            "type": "boolean"
          },
          "timestampMs": {
            "minimum": 0.0,
            "title": "Timestampms",
            "type": "integer"
          }
        },
        "required": [
          "decisionId",
          "participantId",
          "eventSourceIndex",
          "timestampMs",
          "eligible",
          "budgetSource",
          "staleFrame"
        ],
        "title": "DecisionStateSummary",
        "type": "object"
      },
      "DecisionVersionInfo": {
        "additionalProperties": false,
        "description": "Todas as versões que produziram o ponto (linhas imutáveis: uma extração\nantiga continua consultável com as suas versões).",
        "properties": {
          "catalogId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalogid"
          },
          "classificationVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classificationversion"
          },
          "curationRulesVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Curationrulesversion"
          },
          "featureSchemaVersion": {
            "title": "Featureschemaversion",
            "type": "string"
          },
          "reconstructionVersion": {
            "minimum": 1.0,
            "title": "Reconstructionversion",
            "type": "integer"
          },
          "scopeVersion": {
            "title": "Scopeversion",
            "type": "string"
          },
          "selectionVersion": {
            "title": "Selectionversion",
            "type": "string"
          }
        },
        "required": [
          "reconstructionVersion",
          "selectionVersion",
          "featureSchemaVersion",
          "scopeVersion"
        ],
        "title": "DecisionVersionInfo",
        "type": "object"
      },
      "ImportJobAccepted": {
        "additionalProperties": false,
        "description": "202 de POST /imports: job novo ou job ativo reaproveitado.",
        "properties": {
          "jobId": {
            "format": "uuid",
            "title": "Jobid",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ImportJobState"
          },
          "statusUrl": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Statusurl",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "status",
          "statusUrl"
        ],
        "title": "ImportJobAccepted",
        "type": "object"
      },
      "ImportJobKind": {
        "description": "docs/contracts.md: DELETE /matches/{id} cria \"job de expurgo,\nconsultavel em /imports/{jobId} com kind=PURGE\" — import comum e o padrao\nimplicito nas demais rotas de /imports.",
        "enum": [
          "IMPORT",
          "PURGE"
        ],
        "title": "ImportJobKind",
        "type": "string"
      },
      "ImportJobState": {
        "description": "docs/architecture.md: QUEUED -> RUNNING -> SUCCEEDED; RUNNING ->\nRETRY_WAIT -> RUNNING; RUNNING -> FAILED.",
        "enum": [
          "QUEUED",
          "RUNNING",
          "RETRY_WAIT",
          "SUCCEEDED",
          "FAILED"
        ],
        "title": "ImportJobState",
        "type": "string"
      },
      "ImportJobStatus": {
        "additionalProperties": false,
        "description": "200 de GET /imports/{id}.",
        "properties": {
          "attempts": {
            "minimum": 0.0,
            "title": "Attempts",
            "type": "integer"
          },
          "errorCode": {
            "anyOf": [
              {
                "maxLength": 60,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode"
          },
          "kind": {
            "$ref": "#/components/schemas/ImportJobKind",
            "default": "IMPORT"
          },
          "matchId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matchid"
          },
          "retryAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retryat"
          },
          "status": {
            "$ref": "#/components/schemas/ImportJobState"
          }
        },
        "required": [
          "status",
          "attempts"
        ],
        "title": "ImportJobStatus",
        "type": "object"
      },
      "ImportMode": {
        "description": "docs/contracts.md: POST /api/v1/imports {matchId, mode: RIOT ou DEMO}.",
        "enum": [
          "RIOT",
          "DEMO"
        ],
        "title": "ImportMode",
        "type": "string"
      },
      "ImportRequest": {
        "additionalProperties": false,
        "description": "matchId discriminado por mode (plano do CC-106): DEMO so aceita o\nformato do manifesto fechado (DEMO-dddd), RIOT so aceita o padrao BR1\nreal. Nunca libera URL, caminho ou host — o padrao de cada modo ja exclui\nqualquer caractere fora de [A-Z0-9_-].",
        "properties": {
          "matchId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Matchid",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/ImportMode"
          }
        },
        "required": [
          "matchId",
          "mode"
        ],
        "title": "ImportRequest",
        "type": "object"
      },
      "InventoryItem": {
        "additionalProperties": false,
        "properties": {
          "itemId": {
            "minimum": 1.0,
            "title": "Itemid",
            "type": "integer"
          },
          "quantity": {
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "itemId",
          "quantity"
        ],
        "title": "InventoryItem",
        "type": "object"
      },
      "LiveStatus": {
        "properties": {
          "status": {
            "default": "UP",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LiveStatus",
        "type": "object"
      },
      "ObservedLevel": {
        "additionalProperties": false,
        "description": "Nível do mesmo frame estritamente anterior usado para o ouro; ausência\nexplícita (`value` null com `absent_reason`), nunca 0.",
        "properties": {
          "absentReason": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Absentreason"
          },
          "frameAgeMs": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frameagems"
          },
          "value": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "ObservedLevel",
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "requestId"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadyStatus": {
        "properties": {
          "database": {
            "default": "UP",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "default": "UP",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadyStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "RiftLab API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/decisions/{decision_id}": {
      "get": {
        "operationId": "get_decision_api_v1_decisions__decision_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "decision_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Decision Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionState"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Partida, participante ou decisão inexistente."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "decisionId não é um UUID válido."
          }
        },
        "summary": "Get Decision",
        "tags": [
          "decisions"
        ]
      }
    },
    "/api/v1/imports": {
      "post": {
        "operationId": "create_import_api_v1_imports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportJobAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Requisição inválida."
          }
        },
        "summary": "Create Import",
        "tags": [
          "imports"
        ]
      }
    },
    "/api/v1/imports/{job_id}": {
      "get": {
        "operationId": "get_import_api_v1_imports__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportJobStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Job de importação não encontrado."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "job_id não é um UUID válido."
          }
        },
        "summary": "Get Import",
        "tags": [
          "imports"
        ]
      }
    },
    "/api/v1/imports/{job_id}/retry": {
      "post": {
        "operationId": "retry_import_route_api_v1_imports__job_id__retry_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportJobAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Job de importação não encontrado."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Job ainda ativo ou não está FAILED."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "job_id não é um UUID válido."
          }
        },
        "summary": "Retry Import Route",
        "tags": [
          "imports"
        ]
      }
    },
    "/api/v1/matches/{match_id}/decisions": {
      "get": {
        "operationId": "list_match_decisions_api_v1_matches__match_id__decisions_get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "title": "Match Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "participantId",
            "required": true,
            "schema": {
              "maximum": 10,
              "minimum": 1,
              "title": "Participantid",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CursorPage_DecisionStateSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Partida, participante ou decisão inexistente."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Código DECISIONS_NOT_PREPARED: a partida existe, mas as decisões da versão corrente ainda não foram extraídas (cc timeline reconstruct + cc decisions extract). Distinto de 200 com items=[] (extraída com zero pontos)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "VALIDATION_ERROR (parâmetro inválido) ou INVALID_CURSOR (cursor malformado, adulterado, de outra partida/participante ou de extração inexistente)."
          }
        },
        "summary": "List Match Decisions",
        "tags": [
          "decisions"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Nunca depende do banco; processo vivo responde sempre 200.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveStatus"
