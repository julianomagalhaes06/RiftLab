# Copie para .env e ajuste se necessario. Modo DEMO nao exige RIFTLAB_RIOT_API_KEY.
# Nenhum destes valores e um segredo real.

POSTGRES_USER=riftlab
POSTGRES_PASSWORD=riftlab
POSTGRES_DB=riftlab

RIFTLAB_LOG_LEVEL=INFO
RIFTLAB_RIOT_API_KEY=
# HMAC de identificadores pessoais (CC-201) — só exigido para importar em modo
# RIOT de verdade; nunca usado pelo modo demo. Gere um valor local aleatorio
# proprio (ex.: openssl rand -hex 32); isto NAO e um segredo real.
RIFTLAB_SUBJECT_HASH_SECRET=

# E-mails da conta (codigo de confirmacao e de recuperacao de senha). Sem nada aqui, o compose
# usa o Mailpit local: abra http://127.0.0.1:8025 para ver os e-mails.
# Para enviar de verdade pelo Gmail, com verificacao em duas etapas e uma senha de app:
# RIFTLAB_SMTP_HOST=smtp.gmail.com
# RIFTLAB_SMTP_PORT=587
# RIFTLAB_SMTP_STARTTLS=true
# RIFTLAB_SMTP_USERNAME=sua-conta@gmail.com
# RIFTLAB_SMTP_PASSWORD=senha-de-app-do-google
# RIFTLAB_SMTP_FROM=RiftLab <sua-conta@gmail.com>
