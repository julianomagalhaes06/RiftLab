# Local workspace files
# Private runtime, raw data and execution history stay local.
/.private/*
!/.private/artifacts/
!/.private/colab/
/.private/colab/*/bundle-map*.json
/.private/colab/*/riftlab-*-colab/
/.private/colab/*/riftlab-*-colab.zip
/backup_riftlab_ignored.sh
# Downloaded third-party pages can contain browser/session data.
/docs/*.html
/docs/*_files/
/AGENTS.md
/CLAUDE.md
/RTK.md
/.agents/
/.codex/
/.claude/
**/.aws
/skills-lock.json
/*.gpg
.env
.env.*
!.env.example
*.pem
*.key
# Data and model artifacts
/data/
/artifacts/**/logs/
*.log
/mlruns/
/wandb/
*.parquet
*.cbm
*.safetensors
*.gguf
*.pt
# Audited models and aggregate experimental returns are portable project assets.
!/.private/artifacts/**/*.cbm
!/artifacts/**/*.safetensors
# Credentials remain excluded even inside otherwise versioned directories.
**/riot-account*
**/bundle-map*
**/credentials
**/credentials.*
**/id_rsa
**/id_ed25519
**/id_ecdsa
*.p12
*.pfx
# Build, caches and editors
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
node_modules/
dist/
*.tsbuildinfo
playwright-report/
test-results/
.idea/
.vscode/
.DS_Store
