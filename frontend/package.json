{
  "name": "riftlab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "generate:api-types": "openapi-typescript ../backend/openapi.json -o src/shared/api/types.ts",
    "check:api-types": "openapi-typescript ../backend/openapi.json -o /tmp/riftlab-api-types-check.ts && diff -u src/shared/api/types.ts /tmp/riftlab-api-types-check.ts",
    "test:e2e:stack": "playwright test --project=real-stack",
    "test:e2e:demo": "playwright test --project=demo"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
